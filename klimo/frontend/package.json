{
  "name": "klimo-frontend",
  "version": "0.2.6",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/check-boundaries.mjs && tsc -b && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check": "node scripts/check-boundaries.mjs && tsc --noEmit -p tsconfig.json",
    "i18n": "i18next",
    "i18n:check": "i18next --fail-on-update && node scripts/check-locales.mjs",
    "tokens:card": "node scripts/tokens-to-card.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@mantine/core": "^7.16.1",
    "@mantine/hooks": "^7.16.1",
    "@mantine/notifications": "^7.16.1",
    "@tabler/icons-react": "^3.28.1",
    "i18next": "^26.3.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.11"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "i18next-parser": "^9.4.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  }
}
